{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/script_packages.schema.json",
  "title": "Structured YouTube Shorts script packages",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brief_set_id", "generation_status", "scripts"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "brief_set_id": { "type": "string", "minLength": 1 },
    "generation_status": { "type": "string", "const": "codex" },
    "scripts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic_id", "origin", "topic_title", "script_title", "style_id",
          "estimated_duration_seconds", "segments", "source_references", "risk_level",
          "risk_notes", "uncertainties", "requires_human_review", "review_warnings"
        ],
        "properties": {
          "topic_id": { "type": "string", "minLength": 1 },
          "origin": { "type": "string", "enum": ["community_candidate", "manual"] },
          "topic_title": { "type": "string", "minLength": 1 },
          "script_title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "style_id": { "type": "string", "const": "immersive_story_question" },
          "estimated_duration_seconds": { "type": "integer", "minimum": 45, "maximum": 60 },
          "segments": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "order", "role", "narration", "on_screen_text",
                "estimated_seconds", "source_basis", "source_reference_ids"
              ],
              "properties": {
                "order": { "type": "integer", "minimum": 1, "maximum": 5 },
                "role": {
                  "type": "string",
                  "enum": ["hook", "setup", "development", "payoff", "closing"]
                },
                "narration": { "type": "string", "minLength": 1, "maxLength": 1200 },
                "on_screen_text": { "type": "string", "minLength": 1, "maxLength": 120 },
                "estimated_seconds": { "type": "integer", "minimum": 1, "maximum": 30 },
                "source_basis": { "type": "string", "minLength": 1, "maxLength": 500 },
                "source_reference_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "source_references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "source_type", "title", "url", "verification_status"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "source_type": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1 },
                "url": { "type": "string" },
                "verification_status": { "type": "string", "minLength": 1 }
              }
            }
          },
          "risk_level": { "type": "string", "enum": ["low", "medium", "high"] },
          "risk_notes": { "type": "array", "items": { "type": "string" } },
          "uncertainties": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "requires_human_review": { "type": "boolean", "const": true },
          "review_warnings": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        }
      }
    }
  }
}
