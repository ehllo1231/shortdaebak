{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/topic_briefs.schema.json",
  "title": "Source-independent topic briefs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brief_set_id", "count", "topics"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "brief_set_id": { "type": "string", "minLength": 1 },
    "count": { "type": "integer", "minimum": 1 },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version", "topic_id", "origin", "title", "summary",
          "source_material", "source_material_original_length", "source_material_truncated",
          "desired_angle", "audience", "hook_candidates", "source_references",
          "risk_level", "risk_notes", "uncertainties", "provenance"
        ],
        "properties": {
          "schema_version": { "type": "string", "const": "1.0" },
          "topic_id": { "type": "string", "minLength": 1 },
          "origin": { "type": "string", "enum": ["community_candidate", "manual"] },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "source_material": { "type": "string", "minLength": 1, "maxLength": 6000 },
          "source_material_original_length": { "type": "integer", "minimum": 1 },
          "source_material_truncated": { "type": "boolean" },
          "desired_angle": { "type": "string", "minLength": 1 },
          "audience": { "type": "string", "minLength": 1 },
          "hook_candidates": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "source_references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "source_type", "title", "url", "verification_status"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "source_type": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1 },
                "url": { "type": "string" },
                "verification_status": { "type": "string", "minLength": 1 }
              }
            }
          },
          "risk_level": { "type": "string", "enum": ["low", "medium", "high"] },
          "risk_notes": { "type": "array", "items": { "type": "string" } },
          "uncertainties": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "provenance": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["source_run_id", "candidate_rank", "post_id"],
                "properties": {
                  "source_run_id": { "type": "string", "minLength": 1 },
                  "candidate_rank": { "type": "integer", "minimum": 1 },
                  "post_id": { "type": "string", "minLength": 1 }
                }
              },
              { "type": "null" }
            ]
          }
        }
      }
    }
  }
}
